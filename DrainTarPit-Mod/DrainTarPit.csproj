<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DrainTarPit mod. Everything shared by the user's mods (references from Claude\ref, net48, no debug symbols, the shared code Kydl.Common, the KydlCore
    reference, copy to Assets + build + the Gale test profile, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Only what is special about this mod is below.
    Build: dotnet build "DrainTarPit-Mod\DrainTarPit.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>DrainTarPit</AssemblyName>
    <RootNamespace>DrainTarPit</RootNamespace>
    <PackageId>DrainTarPit</PackageId>
    <!-- AssetBundle built by the Unity project; embedded into the DLL when Assets\draintarpit exists -->
    <BundleName>draintarpit</BundleName>
    <!-- 2.0.0: the UI kit, the input lock, the KY hub and the KY-Items registry come from KydlCore.dll (a hard dependency), not from a copy in this DLL -->
    <KydlUseCore>true</KydlUseCore>
  </PropertyGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>