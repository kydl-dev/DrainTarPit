    <AssemblyName>DrainTarPit.UnitTests</AssemblyName>
    <RootNamespace>DrainTarPit.Tests.Unit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(ValheimRefs)\BepInEx.dll</HintPath><Private>true</Private></Reference>
