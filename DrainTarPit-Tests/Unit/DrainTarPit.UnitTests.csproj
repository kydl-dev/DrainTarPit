<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests: pure logic, no game running, no Unity player, no Valheim state. See _agent/TESTING.md. -->
  <PropertyGroup>
    <AssemblyName>DrainTarPit.UnitTests</AssemblyName>
    <RootNamespace>DrainTarPit.Tests.Unit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(ValheimRefs)\BepInEx.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- the liquid rules: a pure file (no Unity / game types) compiled into the tests as well as into the mod -->
    <Compile Include="..\..\DrainTarPit-Mod\src\Drain\HeightField.cs" Link="Mod\HeightField.cs" />
    <!-- per-sender rate limit of the drain / deposit RPCs (bug #9): pure, the clock is passed in -->
    <Compile Include="..\..\DrainTarPit-Mod\src\Drain\SenderThrottle.cs" Link="Mod\SenderThrottle.cs" />
    <!-- T-023: the pool sign's text style (pure) -->
    <Compile Include="..\..\DrainTarPit-Unity\Assets\DTP_UI\Runtime\SignStyle.cs" Link="Mod\SignStyle.cs" />
  </ItemGroup>
</Project>
